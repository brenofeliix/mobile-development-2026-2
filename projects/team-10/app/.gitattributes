# Auto-detect text files and perform LF normalization on checkin
* text=auto

# Ensure shell scripts always use LF (Unix) line endings
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts require CRLF
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary files untouched
*.png binary
*.webp binary
*.jar binary
